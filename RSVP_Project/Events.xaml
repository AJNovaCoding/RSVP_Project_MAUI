<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.Events"
             Title="Events">
    <VerticalStackLayout>
        <Label 
            Text="All Events" 
            HorizontalOptions="Center" />
        <VerticalStackLayout
        x:Name="AllEventsLayout"
        Spacing="5"></VerticalStackLayout>
        <Label
            Text="Hosting Event"
            FontSize="20"/>
        <Label
            Text="Attending Event"
            FontSize="20"/>
        <Label
            Text="Event Details"
            FontSize="20"/>
        <Label
            x:Name="EventDetails"
            Text="Select to view Event Details"/>
        <Button
            Text="RSVP"
            Clicked="OnRSVPClicked"/>
        <Button
            Text="Add Event"
            Clicked="OnAddEventClicked"/>
        <Button
            Text="Logout"
            Clicked="OnLogoutClicked"/>
    </VerticalStackLayout>
</ContentPage>