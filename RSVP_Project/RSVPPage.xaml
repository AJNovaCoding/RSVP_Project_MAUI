<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.RSVPPage"
             Title="RSVPPage">
    <VerticalStackLayout>
        <Label 
            Text="RSVP"
            FontSize="28"
            HorizontalOptions="Center" />
        <Entry
            x:Name="NameEntry"
            Placeholder="Name"/>
        <Entry
            x:Name="EmailEntry"
            Placeholder="Email"/>
        <Entry
            x:Name="PhoneEntry"
            Placeholder="Phone Number"/>
        <Button
            Text="Submit RSVP"
            Clicked="OnSubmitRSVPClicked" />
        <Button
            Text="Cancel"
            Clicked="OnCancelClicked" />
        <Label
            x:Name="MessageLabel"
            Text=""
            TextColor="Purple" />
    </VerticalStackLayout>
</ContentPage>