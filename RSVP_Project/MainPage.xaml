<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="RSVP Application"
                FontSize="30"
                HorizontalOptions="Center" />

            <Label
                Text="Login Page"
                FontSize="24"
                HorizontalOptions="Center" />
            <Entry
                x:Name="UsernameInput"
                Placeholder="Enter your username"/>
            <Entry
                x:Name="PasswordInput"
                Placeholder="Enter your password"
                IsPassword="True"/>
            <Button
                Text="Login" 
                Clicked="OnLoginClicked" />
            <Button
                Text="Continue As Guest"
                Clicked="OnGuestClicked"/>
            <Button
                Text="Create Account"
                Clicked="OnCreateClicked"/>
            <Label
                x:Name="Message"
                Text=""
                TextColor="Purple"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
