<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.AddUser"
             Title="AddUser">
    <VerticalStackLayout>
        <Label 
            Text="Create Account"
            FontSize="28" 
            HorizontalOptions="Center" />
        <Entry
            x:Name="UsernameInput"
            Placeholder="Enter your username"/>
        <Entry
            x:Name="PasswordInput"
            Placeholder="Enter your password"
            IsPassword="True"/>
        <Entry
            x:Name="NameInput"
            Placeholder="Name"/>
        <Entry
            x:Name="EmailInput"
            Placeholder="Email"/>
        <Entry
            x:Name="PhoneInput"
            Placeholder="Phone"/>
        <Button
            Text="Create Account"
            Clicked="OnCreateClicked" />
        <Button
            Text="Cancel"
            Clicked="OnCancelClicked" />
        <Label
            x:Name="Message"
            Text=""
            TextColor="Purple"
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>